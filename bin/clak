#!/usr/bin/env python3
import sys
import os
import argparse
import re
import math
import subprocess
import glob

def calculate_percentiles(values):
    if not values:
        return None
    s = sorted(values)
    n = len(s)
    def get_p(p):
        idx = (p / 100.0) * (n - 1)
        lower = int(math.floor(idx))
        upper = int(math.ceil(idx))
        if lower == upper:
            return s[lower]
        return s[lower] + (s[upper] - s[lower]) * (idx - lower)
    return {
        'count': n,
        'p50': get_p(50),
        'p95': get_p(95),
        'p99': get_p(99),
        'min': s[0],
        'max': s[-1],
        'avg': sum(s) / n
    }

def run_bench(args):
    # if --run is specified, execute benchmark script first
    if args.run:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        repo_root = os.path.abspath(os.path.join(script_dir, ".."))
        bench_script = os.path.join(repo_root, "scripts", "tests", "benchmark_all_groups.sh")
        if os.path.exists(bench_script):
            print(f"Running benchmark suite: {bench_script}...")
            res = subprocess.run(["bash", bench_script], cwd=repo_root)
            if res.returncode != 0:
                print(f"Benchmark run exited with code {res.returncode}")

    log_file = args.log or "/tmp/clak.log"
    if not os.path.exists(log_file):
        print(f"Error: log file '{log_file}' not found. Make sure debug logging is enabled or run with --run")
        sys.exit(1)

    groups = {}
    pattern = re.compile(r'\[LATENCY\]\s+group=([^\s]+)\s+delta_ms=([0-9\.]+)\s+action=([^\s]+)')

    try:
        with open(log_file, 'r', encoding='utf-8', errors='ignore') as f:
            for line in f:
                m = pattern.search(line)
                if m:
                    group, delta_str, action = m.group(1), m.group(2), m.group(3)
                    if action.startswith("REPLACE"):
                        delta = float(delta_str)
                        groups.setdefault(group, []).append(delta)
    except Exception as e:
        print(f"Error reading {log_file}: {e}")
        sys.exit(1)

    if not groups:
        print(f"No latency records found in {log_file}")
        sys.exit(1)

    # filter by schema/group if specified
    target_group = args.schema
    filtered_groups = {}
    if target_group:
        for g, vals in groups.items():
            if target_group.lower() in g.lower():
                filtered_groups[g] = vals
        if not filtered_groups:
            print(f"No records matched schema/group filter: '{target_group}'")
            print(f"Available groups: {', '.join(sorted(groups.keys()))}")
            sys.exit(1)
    else:
        filtered_groups = groups

    # print statistics table
    print(f"\n{'Group':<28} | {'Count':<6} | {'p50 (ms)':<9} | {'p95 (ms)':<9} | {'p99 (ms)':<9} | {'Min':<6} | {'Max':<6}")
    print("-" * 85)
    assertion_failures = []

    for g, vals in sorted(filtered_groups.items()):
        stats = calculate_percentiles(vals)
        print(f"{g:<28} | {stats['count']:<6} | {stats['p50']:<9.2f} | {stats['p95']:<9.2f} | {stats['p99']:<9.2f} | {stats['min']:<6.2f} | {stats['max']:<6.2f}")

        if args.assert_p99_ms is not None:
            if stats['p99'] > args.assert_p99_ms:
                assertion_failures.append(
                    f"Group '{g}' p99 ({stats['p99']:.2f}ms) exceeded threshold ({args.assert_p99_ms:.2f}ms)"
                )

        if args.assert_p95_ms is not None:
            if stats['p95'] > args.assert_p95_ms:
                assertion_failures.append(
                    f"Group '{g}' p95 ({stats['p95']:.2f}ms) exceeded threshold ({args.assert_p95_ms:.2f}ms)"
                )

    print("-" * 85)

    if assertion_failures:
        print("\n❌ Benchmark assertions FAILED:")
        for fail in assertion_failures:
            print(f"  - {fail}")
        sys.exit(1)
    elif args.assert_p99_ms is not None or args.assert_p95_ms is not None:
        print("\n✔ All latency assertions PASSED!")
        sys.exit(0)

def run_doctor(args):
    print("=== CLAK DOCTOR: HỆ THỐNG CHẨN ĐOÁN MÔI TRƯỜNG ===")

    issues = []
    warnings = []

    # 1. system and session environment
    print("\n[1/5] Môi trường hệ thống:")
    uname = os.uname()
    session_type = os.environ.get("XDG_SESSION_TYPE", "unknown")
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "unknown")
    print(f"  • Hệ điều hành: {uname.sysname} {uname.release} ({uname.machine})")
    print(f"  • Session: {session_type} (Desktop: {desktop})")

    # 2. devices and permissions
    print("\n[2/5] Thiết bị ảo và Quyền hạn:")
    uinput_ok = os.access("/dev/uinput", os.W_OK)
    if uinput_ok:
        print(f"  • /dev/uinput: [OK] Khả dụng và có quyền ghi")
    else:
        print(f"  • /dev/uinput: [THIẾU QUYỀN] Người dùng chưa có quyền ghi vào /dev/uinput")
        issues.append("Chưa có quyền ghi vào /dev/uinput. Chạy: echo 'KERNEL==\"uinput\", SUBSYSTEM==\"misc\", TAG+=\"uaccess\"' | sudo tee /etc/udev/rules.d/99-uinput.rules && sudo udevadm trigger /dev/uinput")

    input_devs = glob.glob("/dev/input/event*")
    readable_events = [d for d in input_devs if os.access(d, os.R_OK)]
    if readable_events:
        print(f"  • /dev/input (Mouse Tracking): [OK] Đọc được {len(readable_events)}/{len(input_devs)} thiết bị")
    else:
        print(f"  • /dev/input (Mouse Tracking): [CẢNH BÁO] Không đọc được thiết bị input")
        warnings.append("Thêm user vào nhóm input để bật tính năng reset khi click chuột: sudo usermod -aG input $USER")

    # 3. fcitx5 daemon status
    print("\n[3/5] Trạng thái Daemon Fcitx5:")
    fcitx_pids = []
    for p in glob.glob('/proc/[0-9]*/cmdline'):
        try:
            with open(p, 'rb') as f:
                cmd = f.read().split(b'\0')[0].decode('utf-8', errors='ignore')
                if os.path.basename(cmd) == 'fcitx5':
                    fcitx_pids.append(p.split('/')[2])
        except Exception:
            pass

    if fcitx_pids:
        pid = fcitx_pids[0]
        print(f"  • Tiến trình Fcitx5: [OK] Đang chạy (PID {pid})")
    else:
        print(f"  • Tiến trình Fcitx5: [LỖI] Fcitx5 chưa khởi chạy")
        issues.append("Fcitx5 chưa chạy. Khởi động bằng lệnh: fcitx5 -d")

    try:
        cur_im = subprocess.check_output(['fcitx5-remote', '-n'], text=True).strip()
        print(f"  • Bộ gõ hiện tại: {cur_im}")
        if cur_im != "clak":
            warnings.append(f"Bộ gõ hiện tại là '{cur_im}', chưa chọn Clak (chạy: fcitx5-remote -s clak)")
    except Exception:
        print("  • fcitx5-remote: Không thể kết nối tới Fcitx5")

    # 4. binary inode and memory verification
    print("\n[4/5] Kiểm tra Binary & Nạp bộ nhớ (RAM):")
    if fcitx_pids:
        pid = fcitx_pids[0]
        maps_file = f"/proc/{pid}/maps"
        clak_maps = []
        try:
            with open(maps_file, 'r') as f:
                clak_maps = [line.strip() for line in f if 'clak' in line]
        except Exception as e:
            print(f"  • Lỗi đọc maps: {e}")

        if clak_maps:
            is_deleted = any('(deleted)' in line for line in clak_maps)
            slash_tokens = [tok for tok in clak_maps[0].split() if '/' in tok]
            mapped_path = slash_tokens[0] if slash_tokens else "libclak.so"
            if is_deleted:
                print(f"  • Bộ nhớ: [CẢNH BÁO] Fcitx5 đang giữ inode CŨ trong RAM: {mapped_path}")
                warnings.append("Fcitx5 đang giữ binary cũ trong RAM do vừa build lại file mới. Chạy: fcitx5 -r -d để nạp binary mới nhất")
            else:
                print(f"  • Bộ nhớ: [OK] Đang nạp {mapped_path}")
        else:
            print(f"  • Bộ nhớ: [LỖI] libclak.so chưa được Fcitx5 nạp vào tiến trình")
            issues.append("Fcitx5 chưa nạp libclak.so. Đảm bảo addon đã được cài vào ~/.local/lib/fcitx5 hoặc /usr/lib/fcitx5")

    # 5. configuration and logging
    print("\n[5/5] Cấu hình và Nhật ký (Log):")
    config_path = os.path.expanduser("~/.config/clak/config.toml")
    if os.path.exists(config_path):
        print(f"  • File cấu hình: [OK] {config_path}")
    else:
        print(f"  • File cấu hình: [MẶC ĐỊNH] Chưa tạo file riêng, đang dùng giá trị mặc định")

    log_path = "/tmp/clak.log"
    if os.path.exists(log_path):
        size_kb = os.path.getsize(log_path) / 1024.0
        print(f"  • File log: [OK] {log_path} ({size_kb:.1f} KB)")
    else:
        print(f"  • File log: Chưa kích hoạt ghi log debug vào {log_path}")

    # summary report
    print("\n" + "=" * 55)
    if not issues and not warnings:
        print("✔ TẤT CẢ KIỂM TRA ĐỀU HOÀN HẢO! Clak đã sẵn sàng hoạt động tối ưu.")
    else:
        if issues:
            print(f"\n❌ CẦN XỬ LÝ ({len(issues)} vấn đề):")
            for i, iss in enumerate(issues, 1):
                print(f"  {i}. {iss}")
        if warnings:
            print(f"\n⚠️  LƯU Ý ({len(warnings)} khuyến nghị):")
            for i, warn in enumerate(warnings, 1):
                print(f"  {i}. {warn}")
    print("=" * 55 + "\n")

def run_gui(args):
    script_dir = os.path.dirname(os.path.abspath(__file__))
    repo_root = os.path.abspath(os.path.join(script_dir, ".."))
    gui_bin = os.path.join(repo_root, "build", "ui-target", "release", "clak-gui")
    if not os.path.exists(gui_bin):
        gui_bin = os.path.join(repo_root, "ui", "target", "debug", "clak-gui")
    if os.path.exists(gui_bin):
        os.execv(gui_bin, [gui_bin] + sys.argv[2:])
    else:
        subprocess.run(["cargo", "run", "--manifest-path", "ui/Cargo.toml", "--release"])

def main():
    parser = argparse.ArgumentParser(description="Clak input method utility CLI")
    subparsers = parser.add_subparsers(dest="command")

    bench_parser = subparsers.add_parser("bench", help="Benchmark latency analysis and regression assertion")
    bench_parser.add_argument("--schema", "--group", dest="schema", help="Filter by specific application group name")
    bench_parser.add_argument("--assert-p99-ms", type=float, help="Assert that p99 latency does not exceed threshold in milliseconds")
    bench_parser.add_argument("--assert-p95-ms", type=float, help="Assert that p95 latency does not exceed threshold in milliseconds")
    bench_parser.add_argument("--log", help="Path to log file (default: /tmp/clak.log)")
    bench_parser.add_argument("--run", action="store_true", help="Run benchmark suite before analysis")

    subparsers.add_parser("doctor", help="Inspect environment, uinput permissions, fcitx5 daemon, and loaded binary")
    subparsers.add_parser("gui", help="Launch Clak settings configuration GUI")

    args = parser.parse_args()
    if args.command == "bench":
        run_bench(args)
    elif args.command == "doctor":
        run_doctor(args)
    elif args.command == "gui":
        run_gui(args)
    else:
        parser.print_help()

if __name__ == '__main__':
    main()
